# Copy to .env and fill in. .env is git-ignored; never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

# PostgreSQL (also read by docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_MAX=10
DB_SSL=false

# JWT validation. Provide the values issued by your identity provider; do not invent them.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALGORITHMS=RS256
# Set exactly ONE of the next two:
JWT_PUBLIC_KEY=
JWT_JWKS_URL=
JWT_CLOCK_TOLERANCE_SECONDS=5

# DEV ONLY (used by `npm run dev:token` / `npm run smoke`). Leave unset outside local development.
DEV_JWT_PRIVATE_KEY=

# Origin of the dedicated preview runtime that serves /p/<token>
PREVIEW_ORIGIN=
PREVIEW_TTL_DEFAULT_SECONDS=1800
PREVIEW_TTL_MIN_SECONDS=60
PREVIEW_TTL_MAX_SECONDS=86400

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_RESOLVE_MAX=120

# Authoritative Page/Revision service ("http" in any real environment; "stub" is dev-only)
PAGE_REVISION_MODE=http
PAGE_REVISION_SERVICE_URL=
PAGE_REVISION_SERVICE_TOKEN=
PAGE_REVISION_TIMEOUT_MS=5000
